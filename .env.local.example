# Convex
NEXT_PUBLIC_CONVEX_URL=https://....convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://....convex.site
CONVEX_DEPLOY_KEY=...

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/gallery
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/gallery

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# E2B (code execution sandbox)
E2B_API_KEY=e2b_...

# Gemini (optional, for brand extraction)
GEMINI_API_KEY=...

# Resend (email notifications)
RESEND_API_KEY=re_...

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_CODE_BUCKET_NAME=...

# Secrets encryption
SECRETS_ENCRYPTION_KEY=...

# DEV Floom platform key for the agent's identity
FLOOM_DEV_AGENT_KEY=...
