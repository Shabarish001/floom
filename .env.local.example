# Convex
NEXT_PUBLIC_CONVEX_URL=https://....convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://....convex.site
CONVEX_DEPLOY_KEY=...

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/gallery
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/gallery

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The following are Convex env vars (set via `npx convex env set`, NOT in .env.local):
# E2B_API_KEY, GEMINI_API_KEY, RESEND_API_KEY, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_CODE_BUCKET_NAME, SECRETS_ENCRYPTION_KEY

# DEV Floom platform key for the agent's identity
FLOOM_DEV_AGENT_KEY=...
